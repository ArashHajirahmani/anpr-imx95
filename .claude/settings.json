{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(.venv/bin/ruff *)",
      "Bash(.venv/bin/pytest *)",
      "Bash(.venv/bin/python -m anpr check-config *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git show *)"
    ],
    "deny": [
      "Read(./auto.key)",
      "Read(./tools/host/auto.key)",
      "Edit(../imx-docker/**)",
      "Edit(../yocto-builds/**)",
      "Bash(git push --force*)",
      "Bash(git add auto.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ruff-format.sh"
          }
        ]
      }
    ]
  }
}
