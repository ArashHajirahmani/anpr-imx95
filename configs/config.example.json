{
  "streams": [
    {
      "name": "videoCapture",
      "type": "rtsp",
      "uri": "rtsp://10.0.0.117:8554/videoCapture",
      "enabled": true,
      "pipeline": ""
    },
    {
      "name": "local_test",
      "type": "v4l2",
      "uri": "/dev/video0",
      "enabled": false,
      "pipeline": ""
    }
  ],
  "detector": {
    "path": "/opt/anpr/models/plate_detector.onnx",
    "npu_path": "/opt/anpr/models/plate_detector.int8.onnx",
    "delegate_path": "",
    "conf_threshold": 0.7,
    "input_width": 640,
    "input_height": 640
  },
  "recognizer": {
    "enabled": true,
    "path": "/opt/anpr/models/cct_xs_v2_global.onnx",
    "npu_path": "/opt/anpr/models/cct_xs_v2_global.int8.onnx",
    "delegate_path": "",
    "charset": "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_",
    "min_confidence": 0.07
  },
  "service": {
    "runtime": "cpu",
    "inference_fps_limit": 2,
    "api_socket": "/run/anpr/api.sock",
    "jpeg_quality": 80,
    "history_limit": 4
  },
  "web": {
    "listen_host": "0.0.0.0",
    "listen_port": 8080,
    "poll_seconds": 0.5
  }
