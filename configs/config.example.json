{
  "streams": [
    {
      "name": "videoCapture",
      "type": "rtsp",
      "uri": "rtsp://10.0.0.117:8554/videoCapture",
      "enabled": true,
      "pipeline": ""
    },
    {
      "name": "local_test",
      "type": "v4l2",
      "uri": "/dev/video0",
      "enabled": false,
      "pipeline": ""
    }
  ],
  "detector": {
    "path": "/opt/anpr/models/plate_detector.onnx",
    "npu_path": "/opt/anpr/models/plate_detector.neutron.tflite",
    "delegate_path": "/usr/lib/libneutron_delegate.so",
    "conf_threshold": 0.70,
    "input_width": 640,
    "input_height": 640
  },
  "recognizer": {
    "enabled": true,
    "path": "/opt/anpr/models/cct_s_v2_global.onnx",
    "npu_path": "/opt/anpr/models/cct_s_v2_global.int8.onnx",
    "delegate_path": "",
    "charset": "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_",
    "min_confidence": 0.70,
    "min_char_confidence": 0.70,
    "quality": {
      "enabled": true,
      "min_laplacian_var": 40,
      "min_brightness": 40,
      "max_brightness": 220,
      "min_contrast": 25
    },
    "enhancer": {
      "enabled": true,
      "clahe": true,
      "gamma": 1.1,
      "sharpen": true
    },
    "roi_refine": {
      "expand": {
        "enabled": true,
        "inner_ratio": 0.20,
        "outer_ratio": 0.20,
        "edge_threshold": 0.08,
        "pad_ratio": 0.05
      },
      "perspective": {
        "enabled": false,
        "max_ratio": 0.35,
        "min_score": 0.45,
        "min_aspect": 1.8,
        "max_aspect": 6.0,
        "canny_low": 40,
        "canny_high": 120
      }
    }
  },
  "service": {
    "runtime": "cpu",
    "inference_fps_limit": 2,
    "api_socket": "/run/anpr/api.sock",
    "jpeg_quality": 80,
    "history_limit": 10,
    "ocr_workers": 4
  },
  "web": {
    "listen_host": "0.0.0.0",
    "listen_port": 8080,
    "poll_seconds": 0.5
  }
}
