[Unit]
Description=i.MX95 ANPR web client
After=network.target anpr.service

[Service]
Type=simple
User=anpr
Group=video
WorkingDirectory=/opt/anpr
Environment=PYTHONPATH=/opt/anpr/src
# Environment=ANPR_LOG_LEVEL=DEBUG
ExecStart=/usr/bin/python3 -m anpr web --config /etc/anpr/config.json
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
